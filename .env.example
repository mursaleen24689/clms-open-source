# Copy this file to .env and fill in your own values. Never commit the .env file.

# MySQL connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://clms_user:change-me@127.0.0.1:3306/clms

# Token signing secret, at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# development or production
NODE_ENV=development

# HTTP port for the application (default 3000)
PORT=3000

# Optional: comma separated IP prefixes allowed to call the API.
# Example: 192.168.1.,10.0.0.
# Leave empty to accept every address that can reach the server.
ALLOWED_IP_PREFIXES=

# Initial password used by "pnpm seed" for the example accounts (minimum 12 characters).
# Every seeded account must change it at first sign-in.
SEED_DEFAULT_PASSWORD=

# Optional: full path to mysqldump when it is not on the system path.
# Windows example: C:/xampp/mysql/bin/mysqldump.exe
MYSQLDUMP_PATH=
